void movePistons() {
	while(true) {
		if(master.get_digital_new_press(E_CONTROLLER_DIGITAL_Y)) {
			scraperMech.toggle();
		}
		if(master.get_digital_new_press(E_CONTROLLER_DIGITAL_X)) {
			topPiston.toggle();
		}
		if(master.get_digital_new_press(E_CONTROLLER_DIGITAL_B)){
			wingPiston.toggle();
		}
		delay(10);
	}
}


// This method is how our bot moves during driver control from the sticks
// Brody (backup driver) was used to one-stick, but after practice, he got used to and liked two stick better
void moveMotors() {
	cout << endl;
	while(true) {
		double rightStickValueX = master.get_analog(E_CONTROLLER_ANALOG_RIGHT_X);
		double leftStickValueY = master.get_analog(E_CONTROLLER_ANALOG_LEFT_Y);

		cout << endl;
		right_mg.move_voltage((leftStickValueY - rightStickValueX) * 94.48818898);
		left_mg.move_voltage((leftStickValueY + rightStickValueX) * 94.48818898);

		// To prevent the program from crashing
		pros::Task::delay(20);
	}
}



/**
 * This allows moving the drivetrain to be asynchronous with moving the intake
 * by using two different tasks in the opcontrol() function
 */
void moveIntake() {
	cout << endl;
	int targetVel = 200;
	while(true) {
		if(master.get_digital(E_CONTROLLER_DIGITAL_L1)) {
			intake.move_velocity(targetVel);
			//Unjam check
			if(firstStageIntake.get_actual_velocity() < targetVel/5){
				delay(750);
				if(firstStageIntake.get_actual_velocity() < targetVel/5){
					firstStageIntake.move_velocity(-targetVel);
					delay(500);
					firstStageIntake.move_velocity(targetVel);
				}
			}
		} else if(master.get_digital(E_CONTROLLER_DIGITAL_L2)) {
			intake.move_velocity(-targetVel);
			thirdStageIntake.move_velocity(targetVel);
		} else if(master.get_digital(E_CONTROLLER_DIGITAL_R1)) {
			intake.move_velocity(targetVel);
			//Unjam check
			if(firstStageIntake.get_actual_velocity() < targetVel/5){
				delay(750);
				if(firstStageIntake.get_actual_velocity() < targetVel/5){
					firstStageIntake.move_velocity(-targetVel);
					delay(500);
					firstStageIntake.move_velocity(targetVel);
				}
			}
			topPiston.retract();
		} else if(master.get_digital(E_CONTROLLER_DIGITAL_R2)) {
			thirdStageIntake.move_velocity(-targetVel);
			intake.move_velocity(targetVel);
			//Unjam check
			if(firstStageIntake.get_actual_velocity() < targetVel/5){
				delay(750);
				if(firstStageIntake.get_actual_velocity() < targetVel/5){
					intake.move_velocity(-targetVel);
					delay(500);
					intake.move_velocity(targetVel);
				}
			}
			// topPiston.extend();
		} else {
			intake.move_velocity(0);
			thirdStageIntake.move_velocity(0);
			// topPiston.extend();
		}
		pros::Task::delay(20);
	}
}

